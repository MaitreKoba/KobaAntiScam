<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    tools:context=".SettingsActivity">

    <TextView
        android:id="@+id/settingsTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/settings_title"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginBottom="24dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginBottom="16dp">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_call_filter_role"
            android:textStyle="bold" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_call_filter_desc"
            android:layout_marginTop="4dp" />
        <Button
            android:id="@+id/btnRequestCallFilterRole"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Activer le rôle de filtrage"
            android:textAllCaps="false"
            android:layout_marginTop="8dp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginBottom="16dp">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_notification_access"
            android:textStyle="bold" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_notification_desc"
            android:layout_marginTop="4dp" />
        <Button
            android:id="@+id/btnRequestNotificationAccess"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Activer l'accès aux notifications"
            android:textAllCaps="false"
            android:layout_marginTop="8dp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginBottom="16dp">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_battery_optimization"
            android:textStyle="bold" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_battery_desc"
            android:layout_marginTop="4dp" />
        <Button
            android:id="@+id/btnDisableBatteryOptimization"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Désactiver l'optimisation batterie"
            android:textAllCaps="false"
            android:layout_marginTop="8dp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginBottom="16dp">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="GitHub Repository"
            android:textStyle="bold" />
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etGithubRepo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="ex: kobayashi/shield" />
        </com.google.android.material.textfield.TextInputLayout>
    </LinearLayout>

    <Button
        android:id="@+id/btnCheckUpdate"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/settings_check_update"
        android:textAllCaps="false" />

    <CheckBox
        android:id="@+id/cbAutoCheck"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/settings_auto_check"
        android:layout_marginTop="8dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="16dp">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Mode Strict"
            android:textStyle="bold" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Bloquer tous les numéros sauf ceux dans vos contacts"
            android:layout_marginTop="4dp" />
        <Button
            android:id="@+id/btnStrictMode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Activer le mode strict"
            android:textAllCaps="false"
            android:layout_marginTop="8dp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginBottom="16dp">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Liste Neutre"
            android:textStyle="bold" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Numéros bloqués même s'ils sont dans vos contacts (pour tester)"
            android:layout_marginTop="4dp" />
        <Button
            android:id="@+id/btnManageNeutralList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Gérer la liste neutre"
            android:textAllCaps="false"
            android:layout_marginTop="8dp" />
    </LinearLayout>

</LinearLayout>
