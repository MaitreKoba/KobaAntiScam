<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp">
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etPattern"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/rule_pattern_hint"
            android:inputType="phone" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp">
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Description (optionnel)" />
    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Type de règle:"
        android:layout_marginBottom="8dp" />

    <RadioGroup
        android:id="@+id/rgRuleType"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="16dp">
        <RadioButton
            android:id="@+id/rbCall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/rule_type_call"
            android:checked="true" />
        <RadioButton
            android:id="@+id/rbSms"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/rule_type_sms"
            android:layout_marginStart="16dp" />
    </RadioGroup>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Action:"
        android:layout_marginBottom="8dp" />

    <RadioGroup
        android:id="@+id/rgAction"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginBottom="16dp">
        <RadioButton
            android:id="@+id/rbBlock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/rule_action_block"
            android:checked="true" />
        <RadioButton
            android:id="@+id/rbSilence"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/rule_action_silence"
            android:layout_marginTop="4dp" />
        <RadioButton
            android:id="@+id/rbVoicemail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/rule_action_voicemail"
            android:layout_marginTop="4dp" />
        <RadioButton
            android:id="@+id/rbAllow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/rule_action_allow"
            android:layout_marginTop="4dp" />
    </RadioGroup>

    <CheckBox
        android:id="@+id/cbActive"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/rule_active"
        android:checked="true"
        android:layout_marginBottom="16dp" />

</LinearLayout>
