<!-- FICHIER : activity_messages.xml | CHEMIN : D:/Kobayashi/Developpement/KobayashiAntiScam/app/src/main/res/layout/activity_messages.xml | LIGNES : 202
     RÔLE : Écran Répondeur : en-tête, actualisation, réglages, filtres par catégorie, liste des messages vocaux
     DATE : 2026-10-30 | VERSION : 1.11.0 | ORIGINE : Bouton Réglages avec libellé (l'icône seule passait inaperçue) | AUTEUR : Maitre Kobayashi | STATUT : STABLE
     DÉPENDANCES : item_message.xml, themes.xml | LIEN : MessagesActivity.kt | NOTES : carte de configuration tant que la boîte n'est pas réglée -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingHorizontal="18dp"
    android:paddingTop="12dp"
    tools:context=".MessagesActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/btnRetour"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Retour"
            android:src="@drawable/ic_arrow_back"
            app:tint="?android:attr/textColorPrimary" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Répondeur"
                android:textAppearance="?attr/textAppearanceHeadlineMedium"
                android:textSize="24sp" />

            <TextView
                android:id="@+id/tvResume"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="13sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnActualiser"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Actualiser"
            android:src="@drawable/ic_refresh"
            app:tint="?attr/colorPrimary" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnReglages"
        style="@style/Widget.Material3.Button.TonalButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Réglages : boîte mail, clé Groq, renvois"
        android:textAllCaps="false"
        app:icon="@drawable/ic_tune" />

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/chargement"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:indeterminate="true"
        android:visibility="gone" />

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:scrollbars="none">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/filtres"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:checkedChip="@id/fTous"
            app:selectionRequired="true"
            app:singleLine="true"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip android:id="@+id/fTous" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Tout" />
            <com.google.android.material.chip.Chip android:id="@+id/fLivraison" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Livraison" />
            <com.google.android.material.chip.Chip android:id="@+id/fTravail" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Travail" />
            <com.google.android.material.chip.Chip android:id="@+id/fDemarches" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Démarches" />
            <com.google.android.material.chip.Chip android:id="@+id/fAutre" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Autre" />
            <com.google.android.material.chip.Chip android:id="@+id/fDemarchage" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Démarchage" />
        </com.google.android.material.chip.ChipGroup>
    </HorizontalScrollView>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/carteConfig"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="?attr/policeTitre"
                android:text="Répondeur à configurer"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Indique la boîte mail qui reçoit les messages vocaux de ta ligne OVH. L'app la lit toute seule, toutes les 15 minutes."
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="13sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnConfigurer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Configurer"
                android:textAllCaps="false" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:layout_weight="1">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/carteListe"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/liste"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:paddingVertical="4dp" />
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:id="@+id/vide"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <ImageView
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:background="@drawable/bg_rond"
                android:backgroundTint="@color/tag_fond"
                android:contentDescription="@null"
                android:padding="18dp"
                android:src="@drawable/ic_voicemail"
                app:tint="?attr/colorPrimary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:fontFamily="?attr/policeTitre"
                android:text="Aucun message"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:text="Les messages laissés sur ton répondeur OVH apparaîtront ici, rangés par catégorie."
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="13sp" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
